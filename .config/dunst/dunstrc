[global]
    monitor = 0
    follow = keyboard
    width = 300
    height = 300
    origin = top-right
    offset = 16x48
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 268
    progress_bar_max_width = 268
    progress_bar_corner_radius = 0

    padding = 12
    horizontal_padding = 16
    text_icon_padding = 12
    frame_width = 2
    separator_height = 1
    corner_radius = 0

    font = Monospace 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    stack_duplicates = true
    show_indicators = no

    icon_position = left
    min_icon_size = 24
    max_icon_size = 32
    enable_recursive_icon_lookup = true
    icon_theme = "Yaru-magenta-dark, Yaru, Adwaita"

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    highlight = "#89b4fa"
    frame_color = "#45475a"
    timeout = 4

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    highlight = "#cba6f7"
    frame_color = "#cba6f7"
    timeout = 6

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    highlight = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
