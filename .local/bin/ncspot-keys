#!/usr/bin/env bash
# Two-line ncspot shortcut strip: its own slim pane under ncspot in the show-off
# workspace (kitty --name showoff-keys). Redraws when the pane is resized.
tput civis
K=$'\e[38;2;203;166;247m'; L=$'\e[38;2;127;132;156m'; R=$'\e[0m'
line1="${K}F1${L} queue  ${K}F2${L} search  ${K}F3${L} library  ${K}/${L} filter  ${K}?${L} help  ${K}q${L} quit${R}"
line2="${K}⏎${L} play  ${K}␣${L} add to queue  ${K}P${L} pause  ${K}< >${L} prev/next  ${K}[ ]${L} volume  ${K}z${L} shuffle  ${K}r${L} repeat  ${K}s${L} save${R}"
draw() {
  local cols lines p1 p2 v1 v2
  cols=$(tput cols); lines=$(tput lines)
  v1=$(sed 's/\x1b\[[0-9;]*m//g' <<<"$line1"); v2=$(sed 's/\x1b\[[0-9;]*m//g' <<<"$line2")
  p1=$(( (cols - ${#v1}) / 2 )); p2=$(( (cols - ${#v2}) / 2 )); ((p1<0)) && p1=0; ((p2<0)) && p2=0
  printf '\e[H\e[2J'
  for ((i=0; i<(lines-2)/2; i++)); do echo; done
  printf '%*s%s\n%*s%s' $p1 '' "$line1" $p2 '' "$line2"
}
trap draw WINCH
draw
while :; do sleep 3600 & wait $!; done   # wait forever; WINCH redraws
