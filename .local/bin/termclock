#!/usr/bin/env bash
# Centered clock + date for a terminal pane (show-off workspace), normal font.
tput civis; trap 'tput cnorm; exit' INT TERM
while :; do
  cols=$(tput cols); lines=$(tput lines)
  t=$(date +%H:%M:%S); d=$(date '+%A, %d %B %Y')
  printf '\e[H\e[2J'
  for ((i=0; i<(lines-2)/2; i++)); do echo; done
  printf '%*s\e[38;2;203;166;247m%s\e[0m\n' $(( (cols-${#t})/2 )) '' "$t"
  printf '%*s\e[38;2;166;173;200m%s\e[0m' $(( (cols-${#d})/2 )) '' "$d"
  sleep 1
done
