#!/usr/bin/env bash
# Alt+m / idle music card: focus the Spotify app if it's open, otherwise start it.
# (Terminal clients like ncspot/spotatui can't play on this account: Spotify refuses
#  audio keys to librespot-based players — see README "Spotify".)
if i3-msg -t get_tree | grep -q '"class":"Spotify"'; then
  i3-msg -q '[class="Spotify"] focus'
else
  setsid spotify >/dev/null 2>&1 &
fi
